@@ -124,0 +125,63 @@
+    if MODE=="wide_safe" then
+        translation_api.describe_other_action=function(a)
+            local argument=a.TipHUDArgument
+            if not alive(argument) or argument.ActionName~=25 then return end
+            return argument.msgTag:ToString(),cls(a)
+        end
+        translation_api.placement_sample=function(a,record)
+            local source=a.ExtendedWidget
+            assert(alive(source) and key(source)==record.component,
+                "source mismatch")
+            local w=source:GetUserWidgetObject()
+            assert(alive(w) and key(w)==record.widget,"widget mismatch")
+            local snapshot=Source.snapshot(record,alive,hint_visible)
+            if not snapshot or not snapshot.shown or not snapshot.ready then return nil end
+            local position=source:K2_GetComponentLocation()
+            local cam=w:GetOwningPlayerCameraManager()
+            assert(alive(cam),"camera unavailable")
+            local eye=cam:GetCameraLocation()
+            local function numeric(v)
+                return type(v)=="number" and v==v and math.abs(v)<10000000
+            end
+            for _,v in ipairs({position.X,position.Y,position.Z,eye.X,eye.Y,eye.Z}) do
+                assert(numeric(v),"non-finite sample coordinate")
+            end
+            return string.format(
+                "native_shown=%s native_ready=%s source_xyz=(%.3f,%.3f,%.3f) camera_xyz=(%.3f,%.3f,%.3f) expected_world_z=%.3f geometry_occlusion=UNKNOWN",
+                tostring(snapshot and snapshot.shown==true),
+                tostring(snapshot and snapshot.ready==true),
+                position.X,position.Y,position.Z,eye.X,eye.Y,eye.Z,position.Z+32)
+        end
+        translation_api.selected_probe=function(a)
+            assert(alive(a),"selected actor unavailable")
+            local tag="unavailable"
+            local arg_ok,arg=pcall(function() return a.TipHUDArgument end)
+            if arg_ok and alive(arg) and same(arg:GetOwner(),a) then
+                local token=arg.msgTag:ToString()
+                if type(token)=="string" and #token<=64 and token:match("^[%w_%-]+$") then
+                    tag=token
+                end
+            end
+            local source_ok,source=pcall(function() return a.ExtendedWidget end)
+            if not source_ok or not alive(source) or not same(source:GetOwner(),a) then
+                return nil
+            end
+            local w=source:GetUserWidgetObject()
+            if not alive(w) or source.bVisible~=true or source.bAddedToScreen~=true then
+                return nil
+            end
+            local widget_class=cls(w)
+            local label="unsupported_structure"
+            if widget_class=="/Game/MainContent/Template/UMG/TipHUD.TipHUD_C" then
+                local b=w.TextBlock_89
+                if alive(b) and cls(b)=="/Script/UMG.TextBlock" then
+                    local value=b:GetText():ToString()
+                    label=type(value)=="string" and #value>0 and #value<=512
+                        and not value:find("[\r\n]") and "present" or "not_ready"
+                end
+            end
+            return "owner_class="..cls(a).." tag="..tag..
+                " widget_class="..widget_class.." native_screen=true"..
+                " localized_text="..label.." world_eligibility=UNKNOWN"
+        end
+    end

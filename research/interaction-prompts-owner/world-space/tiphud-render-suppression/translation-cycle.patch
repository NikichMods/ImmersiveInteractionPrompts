+function M.direct_token(w)
+ local child=w.ImageInteractAllowed
+ if not alive(child) or cls(child)~="/Script/UMG.Image" then return nil end
+ local b=child.Brush
+ local tex=b.ResourceObject
+ if not direct({child=child,brush=b}) or not alive(tex) or cls(tex)~="/Script/Engine.Texture2D"
+  or path(tex)=="/Game/MainContent/Assets/UIImage/UI_Widgets/ico_ps4_FaceButton_UP.ico_ps4_FaceButton_UP" then return nil end
+ local pc=w:GetOwningPlayer()
+ if not alive(pc) then return nil end
+ local device=pc:GetNowInputControllerType()
+ if device~=1 and device~=4 then return nil end
+ return tostring(device).."|"..id(tex)
+end
